# Environment configuration template for rep_mini (CFG-001/CFG-002).
# Copy to `.env` and fill in real values at config time.
# NEVER commit `.env` with real values — it is gitignored.

# Supabase project configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_PLACEHOLDER

# Google OAuth client IDs (one per platform; config-time values)
GOOGLE_CLIENT_ID=YOUR_ANDROID_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=YOUR_IOS_OAUTH_CLIENT_ID.apps.googleusercontent.com
